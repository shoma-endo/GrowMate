{
  "rule": [
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 56,
        "matchesPrefix": [
          "supabase-backups/weekly/"
        ]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 365,
        "matchesPrefix": [
          "supabase-backups/monthly/"
        ]
      }
    }
  ]
}
