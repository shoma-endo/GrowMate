{
  "name": "growmate-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "dev:types": "tsc --noEmit --watch",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "supabase:types": "supabase gen types typescript --schema public > src/types/database.types.ts",
    "db:stats": "tsx scripts/check-db-stats.ts",
    "vercel:stats": "tsx scripts/check-vercel-stats.ts",
    "active:users": "tsx scripts/check-active-users.ts",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm audit --omit=dev --audit-level=high && npm run lint && npm run test:coverage && npm run build && npm run knip",
    "hotspots": "bash scripts/hotspots.sh",
    "verify:changed": "bash scripts/verify-changed.sh",
    "verify:agent-skills": "bash scripts/verify-agent-skills.sh",
    "verify:doc-paths": "bash scripts/check-doc-paths.sh",
    "verify:ui-text": "bash scripts/check-ui-text.sh",
    "spec-html:refresh": "python3 scripts/spec-html.py refresh --all",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
    "@tiptap/extension-color": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-table-cell": "^3.30.5",
    "@tiptap/extension-table-header": "^3.30.5",
    "@tiptap/extension-table-row": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/extension-typography": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.37.0",
    "marked": "^18.0.11",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "node-html-parser": "^8.0.4",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "postcss": "^8.5.26",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "^8.5.26",
    "sharp": "0.35.3",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.9"
  }
}
