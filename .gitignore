# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.venv/
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.specstory/

# Supabase
supabase/.temp/

# scripts runtime state (CI は Actions cache で保持)
scripts/db-stats-history.json

# python bytecode cache
__pycache__/

# TAKT project configuration
.takt/*
!.takt/.gitignore
!.takt/config.yaml
!.takt/workflows/
!.takt/workflows/**
!.takt/facets/
!.takt/facets/**
!.takt/schemas/
!.takt/schemas/**

# local-only docs
docs/PROJECT_OVERVIEW.md
docs/project-overview.html
docs/plans/_html/
